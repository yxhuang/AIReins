#!/usr/bin/env bash
# wb（workbench）—— 个人 Agent 工作台的启动器。
# 用法：wb [start|stop|status|restart|logs]   （不带参数 = start）
# 启动后打开本平台默认浏览器；置 WORKBENCH_NO_OPEN=1 可跳过。
set -uo pipefail

# 输出语言：依次看 LC_ALL → LC_MESSAGES → LANG，zh 开头（大小写不敏感）用中文，否则英文。
wb_is_zh() { case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in [zZ][hH]*) return 0;; *) return 1;; esac; }
say() { # say '中文 printf 格式' 'English printf format' [参数…]
  local format="$2"; wb_is_zh && format="$1"; shift 2
  if (( $# )); then printf "$format\n" "$@"; else printf '%s\n' "$format"; fi
}

# BSD readlink 没有 -f；逐层解析安装器建立的软链接。
script="${BASH_SOURCE[0]}"
while [[ -L "$script" ]]; do
  directory="$(cd "$(dirname "$script")" && pwd)"
  script="$(readlink "$script")"
  [[ "$script" == /* ]] || script="$directory/$script"
done
REPO="$(cd "$(dirname "$script")/.." && pwd)"
platform() {
  case "$(uname -s)" in
    Darwin) printf darwin ;;
    Linux)
      if [[ "$(uname -r)" == *[Mm][Ii][Cc][Rr][Oo][Ss][Oo][Ff][Tt]* || -e /proc/sys/fs/binfmt_misc/WSLInterop ]]; then printf wsl; else printf linux; fi ;;
    *) printf unsupported ;;
  esac
}
PLATFORM="$(platform)"
PORT="${WORKBENCH_PORT:-8790}"
LOG="${WORKBENCH_LOG:-$HOME/.workbench/server.log}"
URL="http://127.0.0.1:$PORT"

port_pid() {
  local port="${1:-$PORT}"
  if [[ "$PLATFORM" == darwin ]]; then
    lsof -nP -a -iTCP@127.0.0.1:"$port" -sTCP:LISTEN -t 2>/dev/null | head -1
  else
    ss -ltnp 2>/dev/null | awk -v address="127.0.0.1:$port" '
      $4 == address && match($0, /pid=[0-9]+/) { print substr($0, RSTART + 4, RLENGTH - 4); exit }'
  fi
}

process_command() {
  if [[ "$PLATFORM" == darwin ]]; then ps -p "$1" -o command= 2>/dev/null
  else tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null; fi
}
is_ours() {                       # 占用端口的进程必须是本仓库的工作台
  local pid="$1" cmd
  cmd="$(process_command "$pid")" || return 1
  [[ "$cmd" == *"$REPO/server/index.ts"* ]] && return 0
  # 保留更新前 Linux/WSL 启动的相对路径进程的识别。
  [[ "$PLATFORM" != darwin && "$cmd" == *"server/index.ts"* && "$(readlink "/proc/$pid/cwd" 2>/dev/null)" == "$REPO" ]]
}

open_browser() {
  [[ -n "${WORKBENCH_NO_OPEN:-}" ]] && return 0
  case "$PLATFORM" in
    wsl)
      # WSL 的 URL 打开器退出码不可信，保留原来的忽略规则。
      if command -v wslview >/dev/null 2>&1; then wslview "$URL" >/dev/null 2>&1 || true
      elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$URL" >/dev/null 2>&1 || true; fi ;;
    darwin) open "$URL" >/dev/null 2>&1 || true ;;
    linux) command -v xdg-open >/dev/null 2>&1 && xdg-open "$URL" >/dev/null 2>&1 || true ;;
  esac
  return 0
}

start() {
  local pid; pid="$(port_pid)"
  if [[ -n "$pid" ]]; then
    if is_ours "$pid"; then
      say "工作台已在运行（PID %s） → %s" "Already running (PID %s) → %s" "$pid" "$URL"; open_browser; return 0
    fi
    say "❌ 端口 %s 被别的程序占用（PID %s）：" "❌ Port %s is used by another program (PID %s):" "$PORT" "$pid" >&2
    process_command "$pid" | cut -c1-120 >&2
    say "   换端口：WORKBENCH_PORT=8791 workbench" "   Use another port: WORKBENCH_PORT=8791 workbench" >&2
    return 1
  fi
  if [[ ! -f "$REPO/frontend/dist/index.html" ]]; then
    say "前端尚未构建，执行 npm run build…" "Frontend is not built yet; running npm run build…"
    if ! (cd "$REPO" && npm run build); then
      say "❌ 前端构建失败，工作台未启动；请修复构建错误后重试。" "❌ Frontend build failed; workbench not started. Fix the build errors and retry." >&2
      return 1
    fi
    if [[ ! -f "$REPO/frontend/dist/index.html" ]]; then
      say "❌ 构建后仍缺少 frontend/dist/index.html，工作台未启动。" "❌ frontend/dist/index.html is still missing after the build; workbench not started." >&2
      return 1
    fi
  fi
  mkdir -p "$(dirname "$LOG")"
  # 日志超过 5MB 就轮转成 .1，只留一份旧的（对标 kimi 的按大小轮转）
  [[ -f "$LOG" ]] && (( $(wc -c < "$LOG") > 5242880 )) && mv -f "$LOG" "$LOG.1"
  # setsid 而非仅 nohup：快捷方式经 `wsl.exe -e` 启动时，wsl.exe 退出会连坐清理
  # 整个进程组，nohup 只挡 SIGHUP 挡不住。必须新建会话彻底脱离。
  # exec：让后台那份 bash 直接换成 setsid，别留一个占着调用方 stdout 的壳（否则 `workbench start | cat` 永不返回）
  if [[ "$PLATFORM" == darwin ]]; then
    ( cd "$REPO" && exec nohup env WORKBENCH_PORT="$PORT" node --import tsx "$REPO/server/index.ts" >>"$LOG" 2>&1 < /dev/null & )
  else
    ( cd "$REPO" && exec setsid env WORKBENCH_PORT="$PORT" node --import tsx "$REPO/server/index.ts" >>"$LOG" 2>&1 < /dev/null & )
  fi
  for (( attempt=0; attempt<40; attempt++ )); do
    pid="$(port_pid)"; [[ -n "$pid" ]] && { say "已启动（PID %s） → %s" "Started (PID %s) → %s" "$pid" "$URL"; open_browser; return 0; }
    sleep 0.25
  done
  say "❌ 15 秒内没起来，看日志：%s" "❌ Not up within 15s; check the log: %s" "$LOG" >&2; tail -5 "$LOG" >&2; return 1
}

stop() {
  local pid; pid="$(port_pid)"
  [[ -z "$pid" ]] && { say "没有在运行" "Not running"; return 0; }
  if ! is_ours "$pid"; then say "❌ 端口 %s 上不是本工作台，拒绝停它（PID %s）" "❌ Port %s is not this workbench; refusing to stop it (PID %s)" "$PORT" "$pid" >&2; return 1; fi
  kill "$pid"
  for (( attempt=0; attempt<20; attempt++ )); do [[ -z "$(port_pid)" ]] && { say "已停止" "Stopped"; return 0; }; sleep 0.25; done
  say "⚠ 仍未退出，可手动：kill -9 %s" "⚠ Still not exited; you can run it manually: kill -9 %s" "$pid" >&2; return 1
}

remote_status() {
  local cfg="${WORKBENCH_HOME:-$HOME/.workbench}/remote.json" port="" origin="" rpid=""
  [[ -f "$cfg" ]] || { say "  远程：未配置（见 server/README.md「远程入口配置」）" "  Remote: not configured (see server/README.md「远程入口配置」)"; return 0; }
  read -r port origin < <(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["port"], d["origin"])' "$cfg" 2>/dev/null)
  if [[ -z "$port" ]]; then say "  远程：%s 解析失败" "  Remote: failed to parse %s" "$cfg"; return 0; fi
  rpid="$(port_pid "$port")"
  if [[ "$rpid" == "${1:-}" ]]; then
    say "  远程：%s → 127.0.0.1:%s 监听中" "  Remote: %s → 127.0.0.1:%s listening" "$origin" "$port"
  elif [[ -n "$rpid" ]]; then
    say "  远程：127.0.0.1:%s 被别的程序占用（PID %s），远程入口没起来" "  Remote: 127.0.0.1:%s is used by another program (PID %s); the remote entry is not up" "$port" "$rpid"
  else
    say "  远程：%s → 127.0.0.1:%s 未监听（wb logs 里搜 remote 看原因）" "  Remote: %s → 127.0.0.1:%s not listening (search remote in wb logs for the reason)" "$origin" "$port"
  fi
}

status() {
  local pid; pid="$(port_pid)"
  if [[ -z "$pid" ]]; then say "未运行（端口 %s 空闲）" "Not running (port %s free)" "$PORT"; return 1; fi
  if is_ours "$pid"; then
    say "运行中（PID %s） → %s" "Running (PID %s) → %s" "$pid" "$URL"
    curl -s --noproxy "*" --max-time 2 "$URL/api/meta" | python3 -c 'import json,sys,re; d=json.load(sys.stdin)["data"]; g=lambda v: (re.search(r"[0-9][0-9.]*", v) or [None]) and (re.search(r"[0-9][0-9.]*", v).group(0) if re.search(r"[0-9][0-9.]*", v) else "?"); print("  CLI: " + ", ".join(k + "=" + g(v) for k, v in d["cliVersions"].items()))' 2>/dev/null
    remote_status "$pid"
  else
    say "端口 %s 被别的程序占用（PID %s）" "Port %s is used by another program (PID %s)" "$PORT" "$pid"; return 1
  fi
}

[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

case "${1:-start}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  status ;;
  logs)    tail -f "$LOG" ;;
  *) say "用法：wb [start|stop|restart|status|logs]" "Usage: wb [start|stop|restart|status|logs]" >&2; exit 2 ;;
esac
