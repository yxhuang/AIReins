#!/usr/bin/env bash
# wb（workbench）—— 个人 Agent 工作台的启动器。
# 用法：wb [start|stop|status|restart|logs]   （不带参数 = start）
# 启动后自动在 Windows 侧默认浏览器打开；置 WORKBENCH_NO_OPEN=1 可跳过。
set -uo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PORT="${WORKBENCH_PORT:-8790}"
LOG="${WORKBENCH_LOG:-$HOME/.workbench/server.log}"
URL="http://127.0.0.1:$PORT"

port_pid() { ss -ltnp 2>/dev/null | grep -oP "127\.0\.0\.1:$PORT\b.*pid=\K[0-9]+" | head -1; }

is_ours() {                       # 占用 $PORT 的进程是不是本工作台
  local pid="$1" cmd
  cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" || return 1
  [[ "$cmd" == *"server/index.ts"* ]]
}

open_browser() {                   # 在 Windows 侧默认浏览器打开工作台
  [[ -n "${WORKBENCH_NO_OPEN:-}" ]] && return 0
  # wslview（wslu 提供）最规范；没有就退到 explorer.exe，它是 WSL 自带的。
  # 两者打开 URL 成功时也可能返回非 0（explorer.exe 几乎总是返回 1），
  # 退出码不可信，一律吞掉，绝不让它影响 start 的返回值。
  if command -v wslview >/dev/null 2>&1; then
    wslview "$URL" >/dev/null 2>&1 || true
  elif command -v explorer.exe >/dev/null 2>&1; then
    explorer.exe "$URL" >/dev/null 2>&1 || true
  fi
  return 0
}

start() {
  local pid; pid="$(port_pid)"
  if [[ -n "$pid" ]]; then
    if is_ours "$pid"; then
      echo "工作台已在运行（PID $pid） → $URL"; open_browser; return 0
    fi
    echo "❌ 端口 $PORT 被别的程序占用（PID $pid）：" >&2
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | cut -c1-120 >&2
    echo "   换端口：WORKBENCH_PORT=8791 workbench" >&2
    return 1
  fi
  mkdir -p "$(dirname "$LOG")"
  # 日志超过 5MB 就轮转成 .1，只留一份旧的（对标 kimi 的按大小轮转）
  (( $(stat -c %s "$LOG" 2>/dev/null || echo 0) > 5242880 )) && mv -f "$LOG" "$LOG.1"
  # setsid 而非仅 nohup：快捷方式经 `wsl.exe -e` 启动时，wsl.exe 退出会连坐清理
  # 整个进程组，nohup 只挡 SIGHUP 挡不住。必须新建会话彻底脱离。
  # exec：让后台那份 bash 直接换成 setsid，别留一个占着调用方 stdout 的壳（否则 `workbench start | cat` 永不返回）
  ( cd "$REPO" && exec setsid env WORKBENCH_PORT="$PORT" node --import tsx server/index.ts >>"$LOG" 2>&1 < /dev/null & )
  for _ in $(seq 1 40); do
    pid="$(port_pid)"; [[ -n "$pid" ]] && { echo "已启动（PID $pid） → $URL"; open_browser; return 0; }
    sleep 0.25
  done
  echo "❌ 15 秒内没起来，看日志：$LOG" >&2; tail -5 "$LOG" >&2; return 1
}

stop() {
  local pid; pid="$(port_pid)"
  [[ -z "$pid" ]] && { echo "没有在运行"; return 0; }
  if ! is_ours "$pid"; then echo "❌ 端口 $PORT 上不是本工作台，拒绝停它（PID $pid）" >&2; return 1; fi
  kill "$pid"
  for _ in $(seq 1 20); do [[ -z "$(port_pid)" ]] && { echo "已停止"; return 0; }; sleep 0.25; done
  echo "⚠ 仍未退出，可手动：kill -9 $pid" >&2; return 1
}

remote_status() {
  local cfg="${WORKBENCH_HOME:-$HOME/.workbench}/remote.json" port="" origin="" rpid=""
  [[ -f "$cfg" ]] || { echo "  远程：未配置（见 server/README.md「远程入口配置」）"; return 0; }
  read -r port origin < <(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["port"], d["origin"])' "$cfg" 2>/dev/null)
  if [[ -z "$port" ]]; then echo "  远程：$cfg 解析失败"; return 0; fi
  rpid="$(ss -ltnp 2>/dev/null | grep -oP "127\.0\.0\.1:$port\b.*pid=\K[0-9]+" | head -1)"
  if [[ "$rpid" == "${1:-}" ]]; then
    echo "  远程：$origin → 127.0.0.1:$port 监听中"
  elif [[ -n "$rpid" ]]; then
    echo "  远程：127.0.0.1:$port 被别的程序占用（PID $rpid），远程入口没起来"
  else
    echo "  远程：$origin → 127.0.0.1:$port 未监听（wb logs 里搜 remote 看原因）"
  fi
}

status() {
  local pid; pid="$(port_pid)"
  if [[ -z "$pid" ]]; then echo "未运行（端口 $PORT 空闲）"; return 1; fi
  if is_ours "$pid"; then
    echo "运行中（PID $pid） → $URL"
    curl -s --noproxy "*" --max-time 2 "$URL/api/meta" | python3 -c 'import json,sys,re; d=json.load(sys.stdin)["data"]; g=lambda v: (re.search(r"[0-9][0-9.]*", v) or [None]) and (re.search(r"[0-9][0-9.]*", v).group(0) if re.search(r"[0-9][0-9.]*", v) else "?"); print("  CLI: " + ", ".join(k + "=" + g(v) for k, v in d["cliVersions"].items()))' 2>/dev/null
    remote_status "$pid"
  else
    echo "端口 $PORT 被别的程序占用（PID $pid）"; return 1
  fi
}

case "${1:-start}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  status ;;
  logs)    tail -f "$LOG" ;;
  *) echo "用法：wb [start|stop|restart|status|logs]" >&2; exit 2 ;;
esac
