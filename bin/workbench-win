#!/usr/bin/env bash
# 供 Windows 开始菜单快捷方式调用：拉起工作台，然后在 Windows 侧打开浏览器。
# 注意两个坑（都来自之前做 AOE 面板快捷方式时的教训）：
#   1. 必须先 cd 到 /mnt/c 再调 cmd.exe，否则 cmd 对 WSL 路径会告警；
#      同时这也绕开了仓库路径里 `dev` 的 `=` 被 cmd 解析截断的问题。
#   2. 用绝对路径调 workbench —— `bash -lc` 走的是 login shell，
#      不保证 ~/.local/bin 一定在 PATH 里。
set -uo pipefail

URL="http://127.0.0.1:${WORKBENCH_PORT:-8790}/"

if /home/user/.local/bin/workbench; then
  cd /mnt/c && cmd.exe /c start "" "$URL" >/dev/null 2>&1
else
  echo
  echo "工作台启动失败，上面是原因。"
  echo "常见情形：端口被别的程序占用 —— 可改端口重试："
  echo "  WORKBENCH_PORT=8791 workbench"
  echo
  echo "按回车键关闭此窗口。"
  read -r
fi
