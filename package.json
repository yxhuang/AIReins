{
  "name": "workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit -p frontend",
    "build": "vite build --config frontend/vite.config.ts && node frontend/scripts/precompress.mjs",
    "dev": "vite --config frontend/vite.config.ts",
    "spike:claude": "tsx spikes/claude-loop.ts",
    "spike:codex": "tsx spikes/codex-loop.ts",
    "spike:kimi": "tsx spikes/kimi-loop.ts",
    "test:mentions": "node --import tsx frontend/scripts/mentions.test.mjs",
    "test:store": "node --import tsx frontend/scripts/store-flow.test.mjs",
    "test:attach": "node --import tsx frontend/scripts/attach-flow.test.mjs",
    "test:pages": "node --import tsx frontend/scripts/pages-flow.test.mjs",
    "test:resume": "node --import tsx frontend/scripts/resume-config-flow.test.mjs",
    "test:effective-ask": "node --import tsx frontend/scripts/effective-ask-flow.test.mjs",
    "test:history": "node --import tsx frontend/scripts/history-flow.test.mjs",
    "test:render-items": "node --import tsx frontend/scripts/render-items.test.mjs",
    "test:snapshot": "node --import tsx frontend/scripts/snapshot-flow.test.mjs",
    "test:reconnect": "node --import tsx frontend/scripts/reconnect-flow.test.mjs",
    "test:terminal": "node --import tsx frontend/scripts/terminal.test.mjs",
    "test:font-scale": "node --import tsx frontend/scripts/font-scale.test.mjs",
    "test:server": "n=0; for f in server/*.test.ts; do node --import tsx \"$f\" > /dev/null || { echo \"❌ $f\"; exit 1; }; n=$((n+1)); done; echo \"✅ server 测试全过（$n 个文件）\"",
    "test:markdown": "node --import tsx frontend/scripts/markdown.test.mjs",
    "test:tool-summary": "node --import tsx frontend/scripts/tool-summary.test.mjs",
    "test": "npm run test:mentions && npm run test:store && npm run test:attach && npm run test:pages && npm run test:resume && npm run test:effective-ask && npm run test:history && npm run test:sidebar-panels && npm run test:dispatch-flow && npm run test:render-items && npm run test:snapshot && npm run test:reconnect && npm run test:terminal && npm run test:font-scale && npm run test:server && npm run test:markdown && npm run test:tool-summary && npm run test:restart",
    "test:sidebar-panels": "node --import tsx frontend/scripts/sidebar-panels-flow.test.mjs",
    "test:restart": "node --import tsx frontend/scripts/restart-flow.test.mjs",
    "test:dispatch-flow": "node --import tsx frontend/scripts/dispatch-flow.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3"
  }
}
