{
  "name": "workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit -p frontend",
    "build": "vite build --config frontend/vite.config.ts",
    "dev": "vite --config frontend/vite.config.ts",
    "spike:claude": "tsx spikes/claude-loop.ts",
    "spike:codex": "tsx spikes/codex-loop.ts",
    "spike:kimi": "tsx spikes/kimi-loop.ts",
    "check:theme": "node frontend/scripts/check-theme-parity.mjs",
    "test:mentions": "tsx frontend/scripts/mentions.test.mjs",
    "test:store": "tsx frontend/scripts/store-flow.test.mjs",
    "test:pages": "tsx frontend/scripts/pages-flow.test.mjs",
    "test:resume": "tsx frontend/scripts/resume-config-flow.test.mjs",
    "test:effective-ask": "tsx frontend/scripts/effective-ask-flow.test.mjs",
    "test:history": "tsx frontend/scripts/history-flow.test.mjs",
    "test:render-items": "tsx frontend/scripts/render-items.test.mjs",
    "test:snapshot": "tsx frontend/scripts/snapshot-flow.test.mjs",
    "test:reconnect": "tsx frontend/scripts/reconnect-flow.test.mjs",
    "test:server": "n=0; for f in server/*.test.ts; do tsx \"$f\" > /dev/null || { echo \"❌ $f\"; exit 1; }; n=$((n+1)); done; echo \"✅ server 测试全过（$n 个文件）\"",
    "test": "npm run check:theme && npm run test:mentions && npm run test:store && npm run test:pages && npm run test:resume && npm run test:effective-ask && npm run test:history && npm run test:render-items && npm run test:snapshot && npm run test:reconnect && npm run test:server"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
